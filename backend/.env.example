# ─────────────────────────────────────────────────────
# Backend environment variables – EXAMPLE FILE
# Copy this file to .env and fill in the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local example:  mongodb://localhost:27017/subscription_db
# Atlas example:  mongodb+srv://<username>:<password>@cluster.mongodb.net/subscription_db
MONGODB_URI=mongodb://localhost:27017/subscription_db

# CORS – allow requests from the frontend dev server
FRONTEND_URL=http://localhost:5173

# JSON Web Token (add when implementing authentication)
# JWT_SECRET=replace_with_a_long_random_string
# JWT_EXPIRES_IN=7d
